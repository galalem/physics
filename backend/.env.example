# Copy to `.env` and fill in.

# --- HTTP ---
PORT=8787

# --- Postgres ---
# Full connection string. Any Postgres 16 with `pg_trgm` works;
# managed providers typically require `?sslmode=require`.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- SMTP ---
# Standard smtp[s]://user:pass@host:port URL. Dev uses Mailpit
# (`smtp://localhost:1025`); prod points at whatever relay you use.
SMTP_URL=smtp://localhost:1025
# Address used as From: on outgoing mail. Must be one the relay accepts.
MAIL_FROM="Galalem Physics <no-reply@physics.galalem.tn>"

# --- Public URLs ---
# Base URL of the LMS frontend, used when building links in outgoing
# mail (verification, password reset, etc.). No trailing slash.
PUBLIC_BASE_URL=http://localhost:5173

# --- Cookies ---
# Set to `false` for local http:// dev. Any other value (or unset) → true.
SESSION_COOKIE_SECURE=false

# --- Runtime bundle signing ---
# Shared secret between the backend signer and nginx's secure_link_module
# on the runtime container. Any random 32+ char string; must match on both
# sides. Rotating invalidates every outstanding signed URL.
RUNTIME_SIGNING_SECRET=change-me-to-a-long-random-string

# --- Galalem Payments ---
# API key for the Galalem Payments merchant account. Test-mode key in dev,
# live-mode key in prod. Provisioned per-environment in the GP dashboard.
GALALEM_PAYMENTS_API_KEY=gp_test_change-me
# Shared secret used to verify HMAC signatures on inbound webhook POSTs.
# Rotating requires updating the webhook endpoint in the GP dashboard.
GALALEM_PAYMENTS_WEBHOOK_SECRET=change-me-to-a-long-random-string
